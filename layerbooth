  if(!camUploaded){gl.bindTexture(gl.TEXTURE_2D,tex); gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA,gl.RGBA,gl.UNSIGNED_BYTE,cam); camUploaded=true}
  gl.uniform1f(uni.thr,L.threshold); gl.uniform1f(uni.thick,L.thickness); gl.uniform1f(uni.sm,L.smooth); gl.uniform3fv(uni.col,hex(L.color));
  gl.uniform1i(uni.mode,L.bg==='transparent'?0:L.bg==='black'?1:2); gl.uniform1i(uni.inv,L.invert?1:0);
  gl.clearColor(0,0,0,0); gl.clear(gl.COLOR_BUFFER_BIT); gl.drawArrays(gl.TRIANGLE_STRIP,0,4);
  return glc;
}
function linearCoords(angleDeg){ // gradient line through centre; angle 0 = left→right, 90 = top→bottom
  const a=angleDeg*Math.PI/180, dx=Math.cos(a), dy=Math.sin(a);
  const len=Math.abs(dx)*W+Math.abs(dy)*H; // covers the whole frame
  return [W/2-dx*len/2, H/2-dy*len/2, W/2+dx*len/2, H/2+dy*len/2];
}
function drawSource(L){
  tctx.globalCompositeOperation='source-over'; tctx.globalAlpha=1; tctx.clearRect(0,0,W,H);
  if(L.type==='camera'){ tctx.drawImage(cam,0,0,W,H); }
  else if(L.type==='edges'){ const g=renderEdges(L); if(g) tctx.drawImage(g,0,0); }
  else if(L.type==='color'){ tctx.fillStyle=L.color; tctx.fillRect(0,0,W,H); }
  else if(L.type==='gradient'){
    let g;
    if(L.shape==='radial'){ g=tctx.createRadialGradient(W/2,H/2,0,W/2,H/2,Math.hypot(W,H)/2); }
    else { g=tctx.createLinearGradient(...linearCoords(L.angle)); }
    g.addColorStop(0,rgba(L.color,L.alpha1)); g.addColorStop(1,rgba(L.color2,L.alpha2));
    tctx.fillStyle=g; tctx.fillRect(0,0,W,H);
