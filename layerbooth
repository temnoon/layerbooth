    --bg3: {g('lighter_background', '#353543')}; --fg: {g('foreground', '#cdd6f4')};
    --fg2: {g('dark_foreground', '#9aa1b7')}; --accent: {g('accent', '#89b4fa')};
    --muted: {g('muted', '#45475a')}; --red: {g('red', '#f38ba8')}; --green: {g('green', '#a6e3a1')};
    """

