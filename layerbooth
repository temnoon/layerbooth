class LiveHandler(Guarded):
    """Serves the live compositor page, the foreground stream, and receives its frames."""
    streamer: Streamer = None
    pipe: LivePipe = None
    layers = []
    fps = 30
    quality = 0.8
    size = (0, 0)  # composite at a fixed WxH (0 = the foreground's own size)
    input_bytes = b""
    input_type = "image/jpeg"
    use_input = False

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/live":
            body = (assemble(LIVE_PAGE)
                    .replace("/*LAYERS_JSON*/", json.dumps(self.layers).replace("</", "<\\/"))
                    .replace("/*FPS*/", str(self.fps))
                    .replace("/*QUALITY*/", str(float(self.quality)))
                    .replace("/*SIZE_W*/", str(self.size[0] or 0))
                    .replace("/*SIZE_H*/", str(self.size[1] or 0))
                    .replace("/*DEBUG*/", "true" if "LAYERBOOTH_DEBUG" in os.environ else "false")
                    .replace("/*CAM_SRC*/", "/input" if self.use_input else "/stream")
                    .replace("/*TOKEN*/", self.token)).encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif path == "/stream":
            serve_stream(self, self.streamer)
        elif path == "/input":
            self.send_response(200)
            self.send_header("Content-Type", self.input_type)
            self.send_header("Content-Length", str(len(self.input_bytes)))
            self.end_headers()
            self.wfile.write(self.input_bytes)
        elif path == "/asset":
            serve_asset(self, (parse_qs(urlparse(self.path).query).get("path") or [""])[0])
        else:
            self.send_error(404)

    def do_POST(self):
        path = urlparse(self.path).path
        if path == "/asset/text":
            serve_asset_text(self)
        elif path == "/live-frame":
            data = self.read_body(MAX_IMAGE_BODY)
            if data is None:
                return
            self.pipe.write(data)
            self.send_response(204)
            self.end_headers()
        else:
            self.send_error(404)

def live_cli(args):
    """live [--preset NAME | --layers FILE] [--source camera|test|DEVICE] [--input IMAGE]
            [--out DEVICE|null] [--fps N] [--quality 0-1] [--size WxH]
    Composite a layer stack over a live foreground — the camera, the built-in test pattern,
    another V4L2 device, or a still image (--input) — and write the result to a v4l2loopback
    camera, so OBS and every other video app see it as an ordinary webcam. --size composites
    at a fixed WxH (cheaper than the foreground's own size; OBS rescales); --headed runs the
    compositor in a visible window (GPU-composited, much faster than headless software
    rendering). --out null decodes and discards the frames (debugging)."""
    import tempfile
    preset = layers_file = inp = out_arg = None
    source, fps, quality = "camera", 30, 0.8
    size = (0, 0)
    headed = False
    it = iter(args)
    for a in it:
        if a == "--preset": preset = next(it)
        elif a == "--layers": layers_file = next(it)
        elif a == "--source": source = next(it)
        elif a == "--input": inp = next(it)
        elif a == "--out": out_arg = next(it)
        elif a == "--fps": fps = max(1, int(next(it)))
        elif a == "--quality": quality = max(0.0, min(1.0, float(next(it))))
        elif a == "--size":
            w, h = next(it).lower().split("x")
            size = (int(w), int(h))
        elif a == "--headed": headed = True
        elif a in ("-h", "--help"):
            print(live_cli.__doc__); return 0
        else:
            print(f"live: unknown argument {a!r}", file=sys.stderr); return 2
    if preset:
        p = load_presets()
        if preset not in p["presets"]:
            print(f"live: no preset named {preset!r}", file=sys.stderr); return 1
        layers = p["presets"][preset]["layers"]
    elif layers_file:
        with open(layers_file) as f:
            layers = json.load(f)
        if isinstance(layers, dict): layers = layers.get("layers", [])
    else:
        layers = [DEFAULT_LAYER]
    browser = find_browser()
    if not browser:
        print("live: needs a Chromium-based browser for compositing", file=sys.stderr); return 1

    loopbacks = list_loopbacks()
    discard = out_arg == "null"
    if inp:
        data = sys.stdin.buffer.read() if inp == "-" else open(inp, "rb").read()
        if not data:
            print("live: no input image", file=sys.stderr); return 2
        use_input, input_bytes, input_type = True, data, sniff_type(data)
        streamer, src_desc = None, f"still image {inp}" if inp != "-" else "image on stdin"
    else:
        src = "test" if source == "test" else (DEVICE if source == "camera" else source)
        if src != "test" and not os.path.exists(src):
            print(f"live: no camera at {src} — check --devices, or try --source test", file=sys.stderr); return 1
        use_input, input_bytes, input_type = False, b"", "image/jpeg"
        streamer = foreground_streamer(src)
        src_desc = "the built-in test pattern" if src == "test" else f"camera {src}"

    if discard:
        out_dev, card = None, "discard (debug)"
    elif out_arg:
        out_dev = out_arg
        card = next((c for d, c in loopbacks if d == out_arg), out_arg)
        if not any(d == out_arg for d, _ in loopbacks):
            print(f"live: warning: {out_arg} is not a v4l2loopback device; writing anyway", file=sys.stderr)
    else:
        if not loopbacks:
            print("live: no v4l2loopback device found. Create one with:\n"
                  "  sudo pacman -S v4l2loopback-dkms\n"
                  '  sudo modprobe v4l2loopback devices=1 video_nr=10 card_label="Layerbooth" exclusive_caps=1\n'
                  "then rerun, or pass --out /dev/videoN.", file=sys.stderr)
            return 1
        out_dev, card = loopbacks[0]

    pipe = LivePipe(out_dev, fps)
    LiveHandler.layers = layers
    LiveHandler.fps = fps
    LiveHandler.quality = quality
    LiveHandler.size = size
    LiveHandler.streamer = streamer
    LiveHandler.pipe = pipe
    LiveHandler.input_bytes = input_bytes
    LiveHandler.input_type = input_type
    LiveHandler.use_input = use_input
    LiveHandler.token = secrets.token_urlsafe(32)
    LiveHandler.port = port = free_port()
    httpd = ThreadingHTTPServer(("127.0.0.1", port), LiveHandler)
    httpd.daemon_threads = True
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    pipe.start(discard)
    if streamer:
        streamer.start()
    print(f"Layerbooth live → {card}" + (f" ({out_dev})" if out_dev else "") + f", {fps} fps"
          + (f", {size[0]}x{size[1]}" if size[0] else ""))
    print(f"Foreground: {src_desc}")
    if not discard:
        print(f'In OBS: Sources ➜ + ➜ Video Capture Device (V4L2) ➜ "{card}"')
    print("Ctrl-C to stop.")
    started_at, warned = time.time(), False
    debug = "LAYERBOOTH_DEBUG" in os.environ
    with tempfile.TemporaryDirectory(prefix="layerbooth-live-", dir=os.environ.get("XDG_RUNTIME_DIR"),
                                     ignore_cleanup_errors=True) as profile:
        flags = ["--no-first-run", "--no-default-browser-check",
                 "--disable-extensions", f"--user-data-dir={profile}", "--window-size=1280,720"]
        if not headed:
            flags.insert(0, "--headless=new")
            if "LAYERBOOTH_GPU" not in os.environ:
                flags.append("--disable-gpu")  # SwiftShader is reliable; LAYERBOOTH_GPU=1 tries the real GPU
        if debug:
            flags.append("--enable-logging=stderr")
        proc = subprocess.Popen([browser, *flags, f"http://127.0.0.1:{port}/live?t={LiveHandler.token}"],
                                stdout=subprocess.DEVNULL, stderr=None if debug else subprocess.DEVNULL)
        signal.signal(signal.SIGTERM, lambda *a: proc.terminate())
        try:
            while True:
                time.sleep(0.5)
                if proc.poll() is not None:
                    print("live: compositing browser exited", file=sys.stderr); break
                if pipe.proc and pipe.proc.poll() is not None:
                    print("live: ffmpeg output stopped: " + (" | ".join(pipe.errs[-3:]) or "no error output"),
                          file=sys.stderr); break
                if streamer and streamer.proc and streamer.proc.poll() is not None:
                    hint = (" — the layerbooth panel may be holding the camera; close it, or use --source test"
                            if running_instance() else "")
                    print(f"live: foreground stream stopped{hint}", file=sys.stderr); break
                if not pipe.sent and not warned and time.time() - started_at > 20:
                    warned = True
                    print("live: no composited frames yet — is the foreground producing video?", file=sys.stderr)
        except KeyboardInterrupt:
            pass
        finally:
            proc.terminate()
            try:
                proc.wait(5)
            except subprocess.TimeoutExpired:
                proc.kill()
    httpd.shutdown()
    if streamer:
        streamer.stop()
    pipe.stop()
    print(f"live: sent {pipe.sent} frames")
    return 0

# ---------------------------------------------------------------- page export (gravity-press PageSpec v1)
# Lulu trim codes are hundredths of an inch, WIDTHxHEIGHT. The first seven appear in Lulu's own
# OpenAPI spec; A5 is what gravity-press already ships. Names are Lulu's product names.
TRIMS = {
    "0425X0687": "Pocket Book",
    "0500X0800": "Novella",
    "0550X0850": "Digest",
    "0583X0827": "A5",
    "0600X0900": "US Trade",
    "0700X1000": "Executive",
    "0827X1169": "A4",
    "0850X1100": "US Letter",
}
# gravity-press PageSpec paper names (its PaperSize enum) and their trims
PAPER_NAMES = {"LETTER": "0850X1100", "A4": "0827X1169", "A5": "0583X0827", "HALF_LETTER": "0550X0850"}
STRUCTURES = {"lines": "lined", "dots": "dot", "grid": "cartesian", "polar": "polar"}

def trim_inches(code):
    m = re.fullmatch(r"(\d{4})X(\d{4})", code)
    if not m:
        raise ValueError(f"unknown paper {code!r}; use a name ({', '.join(PAPER_NAMES)}) or a Lulu trim code ({', '.join(TRIMS)})")
    return int(m.group(1)) / 100, int(m.group(2)) / 100

def resolve_paper(paper):
    """Accepts LETTER/A4/A5/HALF_LETTER, a Lulu code like 0600X0900, or WxH inches like 6x9.
    Returns (pagespec_paper_name_or_code, trim_code, width_in, height_in)."""
    p = paper.strip().upper().replace("-", "_").replace('"', "")
    if p in PAPER_NAMES:
        code = PAPER_NAMES[p]
    elif re.fullmatch(r"\d{4}X\d{4}", p):
        code = p
    elif re.fullmatch(r"\d+(\.\d+)?X\d+(\.\d+)?", p):
        w, h = (float(x) for x in p.split("X"))
        code = f"{int(round(w*100)):04d}X{int(round(h*100)):04d}"
    else:
        raise ValueError(f"unknown paper {paper!r}; use a name ({', '.join(PAPER_NAMES)}), a Lulu code ({', '.join(TRIMS)}) or WxH inches")
    w_in, h_in = trim_inches(code)
    names = {v: k for k, v in PAPER_NAMES.items()}
    return names.get(code, code), code, w_in, h_in

def blank_png(w, h):
    """A transparent w×h PNG without Pillow: one filter byte + RGBA zeros per row."""
    import struct, zlib
    raw = b"".join(b"\x00" + b"\x00" * (w * 4) for _ in range(h))
    def chunk(t, d):
        return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))

def render_headless(data, layers, fmt="image/png", quality=0.92):
    """Composite `layers` over the input image bytes with the page's own compositor. Returns bytes."""
    import tempfile
    browser = find_browser()
    if not browser:
        raise RuntimeError("needs a Chromium-based browser for headless rendering")
    RenderHandler.input_bytes = data
    RenderHandler.input_type = sniff_type(data)
    RenderHandler.layers = layers
    RenderHandler.fmt = fmt
    RenderHandler.quality = max(0.0, min(1.0, quality))
    RenderHandler.result = None
    RenderHandler.done.clear()
    port = free_port()
    RenderHandler.token = secrets.token_urlsafe(32)
    RenderHandler.port = port
    httpd = ThreadingHTTPServer(("127.0.0.1", port), RenderHandler)
    httpd.daemon_threads = True
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    try:
        with tempfile.TemporaryDirectory(prefix="layerbooth-render-", dir=os.environ.get("XDG_RUNTIME_DIR"),
                                         ignore_cleanup_errors=True) as profile:
            proc = subprocess.Popen([browser, "--headless=new", "--disable-gpu", "--no-first-run", "--no-default-browser-check",
                                     "--disable-extensions", f"--user-data-dir={profile}", "--window-size=1280,720",
                                     f"http://127.0.0.1:{port}/render?t={RenderHandler.token}"],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            ok = RenderHandler.done.wait(90)
            proc.terminate()
            try: proc.wait(5)
            except subprocess.TimeoutExpired: proc.kill()
    finally:
        httpd.shutdown()
    if not ok or RenderHandler.result is None:
        raise RuntimeError("browser produced no output within 90s")
    status, payload = RenderHandler.result
    if status != "ok":
        raise RuntimeError(payload)
    return payload

def has_raster(layers):
    """Photos want JPEG; pattern-only pages (SVG, gradient, colour, edges) stay PNG."""
    for L in layers:
        if not L.get("enabled", True):
            continue
        if L.get("type") == "camera":
            return True
        if L.get("type") == "image" and not str(L.get("path", "")).lower().endswith(".svg"):
            return True
    return False

def optimise_png(data):
    """Shrink a PNG with ImageMagick when it is available; otherwise return it unchanged."""
    import shutil
    if not shutil.which("magick"):
        return data
    r = subprocess.run(["magick", "png:-", "-strip", "-define", "png:compression-level=9",
                        "-define", "png:compression-filter=5", "png:-"], input=data, capture_output=True)
    return r.stdout if r.returncode == 0 and 0 < len(r.stdout) < len(data) else data

def render_ground(layers, w, h, input_bytes=None, image_format="auto", quality=0.88):
    """Render the look at w×h. Returns (bytes, mime, sha256)."""
    import hashlib
    if input_bytes is None:
        input_bytes = blank_png(w, h)          # camera layers draw nothing; SVG/gradient/colour layers carry the page
    fmt = image_format
    if fmt == "auto":
        fmt = "jpg" if (has_raster(layers) and input_bytes is not None) else "png"
    if fmt == "jpg" and input_bytes is not None and has_raster(layers):
        data, mime = render_headless(input_bytes, layers, "image/jpeg", quality), "image/jpeg"
    else:
        data, mime = optimise_png(render_headless(input_bytes, layers, "image/png")), "image/png"
    return data, mime, hashlib.sha256(data).hexdigest()

def build_page_spec(layers, paper="LETTER", dpi=150, ground="image", wash_opacity=0.12, structure="none",
                    input_bytes=None, preset=None, image_format="auto", quality=0.88, assets=None):
    """Render the look at paper size and wrap it as a gravity-press PageSpec v1.
    With `assets` (a dict), the image is stored there by sha256 and referenced as asset:<sha256>
    instead of being inlined, so repeated pages share one copy."""
    import base64
    paper_name, trim, w_in, h_in = resolve_paper(paper)
    w, h = int(round(w_in * dpi)), int(round(h_in * dpi))
    had_input = input_bytes is not None
    data, mime, digest = render_ground(layers, w, h, input_bytes, image_format, quality)
    if assets is not None:
        assets[digest] = (data, mime)
        src = f"asset:{digest}"
    else:
        src = f"data:{mime};base64," + base64.b64encode(data).decode("ascii")
    image_cfg = {"version": 1, "type": "image", "paper": paper_name, "src": src,
                 "fit": "cover", "offsetX": 0, "offsetY": 0}  # imageWidth/Height are page inches; default = full page
    if ground == "wash":
        g = {"kind": "wash", "config": image_cfg, "opacity": max(0.02, min(0.5, float(wash_opacity)))}
    else:
        g = {"kind": "image", "config": image_cfg}
    spec = {"version": 1, "paper": paper_name, "ground": g, "structure": [], "content": [], "overlay": []}
    if structure and structure != "none":
        if structure not in STRUCTURES:
            raise ValueError(f"structure must be one of none, {', '.join(STRUCTURES)}")
        spec["structure"].append({"kind": structure, "config": {"version": 1, "type": STRUCTURES[structure], "paper": paper_name}})
    # Kept for re-editing in Layerbooth; the PageSpec parser drops unknown keys.
    spec["layerbooth"] = {"preset": preset, "layers": layers, "dpi": dpi, "trim": trim,
                          "rendered": {"width": w, "height": h, "mime": mime, "sha256": digest}}
    if paper_name not in PAPER_NAMES:
        spec["layerbooth"]["note"] = (f"paper {paper_name} is a Lulu trim outside gravity-press's PaperSize enum "
                                      "(LETTER, A4, A5, HALF_LETTER); it validates once the enum is extended")
    return spec

def write_assets(assets, out_dir):
    """assets/<sha256>.<ext> next to the spec; identical grounds are written once."""
    os.makedirs(out_dir, exist_ok=True)
    written = []
    for digest, (data, mime) in assets.items():
        ext = ".jpg" if mime == "image/jpeg" else ".png"
        path = os.path.join(out_dir, digest + ext)
        if not os.path.exists(path):
            with open(path, "wb") as f:
                f.write(data)
        written.append(path)
    return written

def page_cli(args):
    """page [--preset NAME | --layers FILE] [--paper LETTER|A5|0600X0900|6x9] [--dpi N]
         [--ground image|wash] [--wash-opacity 0.12] [--structure none|lines|dots|grid|polar]
         [--input IMAGE|-] [--image-format auto|png|jpg] [--quality 0.88]
         [--assets DIR] [--document COUNT] [--title T] [--out FILE] [--trims]
    Renders a look at paper size and writes a gravity-press PageSpec v1 (or a DocumentSpec with
    --document) as JSON to --out or stdout. Without --input the camera layers are blank.
    --assets DIR stores the ground as DIR/<sha256>.png|jpg and references it as asset:<sha256>,
    so identical pages share one file. --trims lists the Lulu trim sizes."""
    preset = layers_file = out = inp = title = assets_dir = None
    paper, dpi, ground, wash, structure, count = "LETTER", 150, "image", 0.12, "none", 0
    image_format, quality = "auto", 0.88
    it = iter(args)
    for a in it:
        if a == "--preset": preset = next(it)
        elif a == "--layers": layers_file = next(it)
        elif a == "--paper": paper = next(it).upper().replace("-", "_")
        elif a == "--dpi": dpi = int(next(it))
        elif a == "--ground": ground = next(it)
        elif a == "--wash-opacity": wash = float(next(it))
        elif a == "--structure": structure = next(it)
        elif a == "--input": inp = next(it)
        elif a == "--document": count = int(next(it))
        elif a == "--title": title = next(it)
        elif a == "--out": out = next(it)
        elif a == "--image-format": image_format = next(it).lower().lstrip(".").replace("jpeg", "jpg")
        elif a == "--quality": quality = float(next(it))
        elif a == "--assets": assets_dir = next(it)
        elif a == "--trims":
            for code, name in TRIMS.items():
                w_in, h_in = trim_inches(code)
                print(f"{code}  {w_in:g} × {h_in:g} in  {name}")
            return 0
        elif a in ("-h", "--help"): print(page_cli.__doc__); return 0
        else:
            print(f"page: unknown argument {a!r}", file=sys.stderr); return 2
    if preset:
        p = load_presets()
        if preset not in p["presets"]:
            print(f"page: no preset named {preset!r}", file=sys.stderr); return 1
        layers = p["presets"][preset]["layers"]
    elif layers_file:
        with open(layers_file) as f:
            layers = json.load(f)
        if isinstance(layers, dict): layers = layers.get("layers", [])
    else:
        print("page: give --preset NAME or --layers FILE", file=sys.stderr); return 2
    data = None
    if inp:
        data = sys.stdin.buffer.read() if inp == "-" else open(inp, "rb").read()
    assets = {} if assets_dir else None
    try:
        spec = build_page_spec(layers, paper, dpi, ground, wash, structure, data, preset, image_format, quality, assets)
    except (ValueError, RuntimeError) as e:
        print(f"page: {e}", file=sys.stderr); return 1
    if count:
        trim = spec["layerbooth"]["trim"]
        spec = {"version": 1, "trim": trim, "includeBleed": True,
                "meta": {"title": title or preset or "Layerbooth notebook"},
                "pages": [{"template": spec, "count": count}]}
        if trim not in TRIMS:
            print(f"page: note: {trim} is not a known Lulu trim; check Lulu's product sheet", file=sys.stderr)
    if assets:
        for path in write_assets(assets, assets_dir):
            print(f"asset {path} ({os.path.getsize(path)//1024} KiB)", file=sys.stderr)
    text = json.dumps(spec)
    if out and out != "-":
        with open(out, "w") as f: f.write(text)
        print(f"wrote {out} ({len(text)//1024} KiB)", file=sys.stderr)
    else:
        sys.stdout.write(text); sys.stdout.flush()
    return 0

# ---------------------------------------------------------------- main
def free_port():
    s = socket.socket(); s.bind(("127.0.0.1", 0)); p = s.getsockname()[1]; s.close(); return p

def cli_apply(name):
    p = load_presets()
    name = name or p.get("login")
    if not name:
        print("No preset marked for login; nothing applied.", file=sys.stderr); return 0
    vals = p["presets"].get(name)
    if vals is None:
        print(f"No preset named {name!r}", file=sys.stderr); return 1
    vals = preset_controls(vals)
    # camera module may still be probing right after boot
    for _ in range(20):
        if os.path.exists(DEVICE): break
        time.sleep(0.5)
    ok, err = set_controls(vals)
    print(f"Applied preset {name!r}" if ok else f"Failed: {err}", file=sys.stderr)
    return 0 if ok else 1

def instance_file():
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR") or CONFIG_DIR, "layerbooth.instance")

def running_instance():
    """PID of a live panel server started by this user, or None."""
    try:
        with open(instance_file()) as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None

def focus_existing():
    """Raise the open panel window instead of starting a second camera server."""
    import shutil
    if shutil.which("hyprctl"):
        try:
            clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout)
            for c in clients:
                if "__layerbooth" in c.get("class", ""):
                    subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{c["address"]}" }})'],
                                   capture_output=True)
                    return True
        except (ValueError, KeyError):
            pass
    return False

def serve():
    if running_instance():
        if not focus_existing():
            print("layerbooth is already running", file=sys.stderr)
        return
    port = free_port()
    Handler.token = secrets.token_urlsafe(32)
    Handler.port = port
    Handler.streamer = Streamer(DEVICE)
    Handler.colors = theme_colors()
    httpd = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    httpd.daemon_threads = True
    Handler.server_ref = httpd
    url = f"http://127.0.0.1:{port}/layerbooth?t={Handler.token}"  # path becomes part of Chromium's app id
    if "--no-browser" not in sys.argv:
        which = __import__("shutil").which
        if which("omarchy-launch-webapp"):
            cmd = ["omarchy-launch-webapp", url, "--window-size=1280,780"]
        else:
            browser = find_browser()
            if not browser:
                print("layerbooth: no Chromium-based browser found; open this URL yourself:", url, file=sys.stderr)
                cmd = None
            else:
                cmd = [browser, f"--app={url}", "--window-size=1280,780"]
        if cmd:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    else:
        print(url, flush=True)

    def idle_watch():
        st = Handler.streamer
        while True:
            time.sleep(5)
            if st.clients == 0 and time.time() - st.last_client > IDLE_EXIT_SECONDS:
                httpd.shutdown(); return
    threading.Thread(target=idle_watch, daemon=True).start()
    signal.signal(signal.SIGTERM, lambda *a: threading.Thread(target=httpd.shutdown).start())
    try:
        with open(instance_file(), "w") as f:
            f.write(str(os.getpid()))
    except OSError:
        pass
    try:
        httpd.serve_forever()
    finally:
        Handler.streamer.stop()
        try:
            os.unlink(instance_file())
        except OSError:
            pass

if __name__ == "__main__":
    args = sys.argv[1:]
    if "--device" in args:
        DEVICE = args[args.index("--device") + 1]
    else:
        DEVICE = detect_device()
    if "--devices" in args:
        for dev, name in list_devices():
            print(f"{dev}  {name}")
        sys.exit(0)
    if args and args[0] == "render":
        sys.exit(render_cli(args[1:]))
    if args and args[0] == "page":
        sys.exit(page_cli(args[1:]))
    if args and args[0] == "live":
        sys.exit(live_cli(args[1:]))
    if "--list" in args:
        p = load_presets()
        for n, v in sorted(p["presets"].items()):
            c = preset_controls(v); nl = len(v["layers"]) if isinstance(v, dict) and "layers" in v else 0
            print(("* " if p["login"] == n else "  ") + n + "  " + ", ".join(f"{k}={x}" for k, x in c.items()) + f"  [{nl} layers]")
        sys.exit(0)
    if "--apply" in args:
        i = args.index("--apply")
        name = args[i + 1] if i + 1 < len(args) and not args[i + 1].startswith("--") else None
        sys.exit(cli_apply(name))
    if "-h" in args or "--help" in args:
        print(__doc__); sys.exit(0)
    serve()
