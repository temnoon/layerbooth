*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:13px/1.4 system-ui,sans-serif;height:100vh;display:grid;grid-template-columns:1fr 380px;overflow:hidden}
.view{display:flex;flex-direction:column;background:var(--bg2);min-width:0}
.stage{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;background:#000}
canvas#out{max-width:100%;max-height:100%;object-fit:contain}
canvas#out.mirror{transform:scaleX(-1)}
.toolbar{display:flex;gap:8px;padding:10px;align-items:center;border-top:1px solid var(--bg3)}
.toolbar .spacer{flex:1}
aside{padding:12px;overflow:auto;border-left:1px solid var(--bg3);display:flex;flex-direction:column;gap:12px}
h2{margin:14px 0 2px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--fg2);display:flex;align-items:center;gap:8px}
h2 .spacer{flex:1}
.ctl{display:grid;grid-template-columns:1fr auto;gap:0 8px;align-items:center}
.ctl label{text-transform:capitalize}
.ctl .val{font-variant-numeric:tabular-nums;color:var(--fg2);min-width:3ch;text-align:right}
.ctl input[type=range]{grid-column:1/-1;width:100%;accent-color:var(--accent);margin:0 0 4px}
.ctl.bool{grid-template-columns:auto 1fr}
button,select,input[type=text]{background:var(--bg3);color:var(--fg);border:1px solid var(--muted);border-radius:6px;padding:5px 9px;font:inherit}
button{cursor:pointer}button:hover{border-color:var(--accent)}
button.primary{background:var(--accent);color:var(--bg);border-color:var(--accent);font-weight:600}
button.icon{padding:2px 6px;font-size:12px;line-height:1}
button.danger:hover{border-color:var(--red);color:var(--red)}
.row{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.row>input[type=text]{flex:1}
.preset{display:flex;align-items:center;gap:6px;padding:3px 0}
.preset .name{flex:1;cursor:pointer}.preset .name:hover{color:var(--accent)}
.preset .login{color:var(--fg2);font-size:11px;cursor:pointer}
.preset .login.on{color:var(--green)}
.preset .x{color:var(--fg2);cursor:pointer;padding:0 4px}.preset .x:hover{color:var(--red)}
.status{color:var(--fg2);font-size:12px;min-height:1.4em;line-height:1.35}
.check{display:flex;align-items:center;gap:6px;color:var(--fg2)}
details{border:1px solid var(--bg3);border-radius:8px;background:var(--bg2)}
details>summary{list-style:none;cursor:pointer;padding:6px 8px;display:flex;align-items:center;gap:6px}
details>summary::-webkit-details-marker{display:none}
details[open]>summary{border-bottom:1px solid var(--bg3)}
.layer-body{padding:8px;display:flex;flex-direction:column;gap:6px}
.layer-body .grid{display:grid;grid-template-columns:auto 1fr;gap:4px 8px;align-items:center}
.layer-body .grid label{color:var(--fg2)}
.sw{width:14px;height:14px;border-radius:3px;border:1px solid var(--muted)}
.lname{flex:1;font-weight:600}
.dim{color:var(--fg2)}
input[type=color]{width:36px;height:24px;padding:0;border:1px solid var(--muted);border-radius:4px;background:var(--bg3)}
.sub{margin-top:4px;padding-top:6px;border-top:1px dashed var(--bg3)}
.sub h3{margin:0 0 4px;font-size:11px;color:var(--fg2);text-transform:uppercase;letter-spacing:.06em}
.grid2{display:grid;grid-template-columns:auto 1fr;gap:6px 8px;align-items:center}
.grid2 label{color:var(--fg2)}
.grid2 input[type=text]{width:100%}
.preset .name.current{color:var(--accent);font-weight:600}
</style></head><body>
<div class="view">
  <div class="stage"><canvas id="out" width="1280" height="720"></canvas></div>
  <div class="toolbar">
    <label class="check"><input type="checkbox" id="mirror" checked> Mirror preview</label>
    <span class="spacer"></span>
    <span class="status" id="status"></span>
    <button class="primary" onclick="snap()">📷 Snapshot</button>
    <button onclick="quit()">Close</button>
  </div>
</div>
<aside>
  <h2>Camera</h2>
  <div id="controls"></div>
  <div class="row"><button onclick="resetAll()">Reset camera defaults</button></div>

  <h2>Layers <span class="spacer"></span>
    <select id="addtype"><option value="camera">Camera</option><option value="image">Image / SVG</option><option value="warp">Warp (geometry effect)</option><option value="edges">Edges</option><option value="color">Colour</option><option value="gradient">Gradient</option></select>
    <button class="icon" onclick="addLayer()">+ Add</button></h2>
  <div id="layers"></div>
  <div class="status">Top of the list is drawn on top. Masks carve each layer's alpha with a gradient.</div>

  <h2>Presets</h2>
  <div id="presets"></div>
  <div class="row"><input type="text" id="pname" placeholder="Preset name"><button class="primary" id="psave" onclick="savePreset()">Save</button></div>
  <div class="status">Click a preset to load it; its name fills the field, so Update overwrites it. Type a new name to save a copy. ☆ marks the one applied at login.</div>

  <h2>Snapshots</h2>
  <div class="grid2">
    <label>Folder</label><div class="row"><input type="text" id="sfolder" placeholder="~/Pictures"><button class="icon" onclick="openFolder()" title="Open folder">📂</button></div>
    <label>Filename</label><input type="text" id="stemplate" placeholder="camera-[datetime]">
  </div>
  <div class="status">Tokens: [preset] [date] [time] [datetime] [n] &nbsp;·&nbsp; a / makes sub-folders &nbsp;·&nbsp; extension is added automatically</div>
  <div class="row"><span class="status" id="sexample" style="flex:1"></span><button onclick="saveSettings()">Save settings</button></div>
</aside>
<img id="cam" alt="" hidden>
<script>
const $=s=>document.querySelector(s);
const TOKEN='/*TOKEN*/';
const esc=v=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
$('#cam').src='/stream?t='+encodeURIComponent(TOKEN);
let W=1280,H=720;
let state={controls:[],presets:{presets:{},login:null,settings:{}}};
let currentPreset='';
const post=(u,b)=>fetch(u,{method:'POST',headers:{'Content-Type':'application/json','X-Token':TOKEN},body:JSON.stringify(b||{})}).then(r=>r.json());
const say=m=>{$('#status').textContent=m; setTimeout(()=>{if($('#status').textContent===m)$('#status').textContent=''},3000)};
$('#mirror').onchange=e=>$('#out').classList.toggle('mirror',e.target.checked);
$('#mirror').onchange({target:$('#mirror')});

/* ---------------- camera (v4l2) controls ---------------- */
function renderControls(){
  const box=$('#controls'); box.innerHTML='';
  for(const c of state.controls){
    const d=document.createElement('div'); d.className='ctl'+(c.type==='bool'?' bool':'');
    if(c.type==='bool'){
      d.innerHTML=`<input type="checkbox" id="c_${esc(c.name)}" ${c.value?'checked':''} ${c.inactive?'disabled':''}><label for="c_${esc(c.name)}">${esc(c.label)}</label>`;
      d.querySelector('input').onchange=e=>setCtl(c.name,e.target.checked?1:0);
    }else if(c.menu&&c.menu.length){
      d.innerHTML=`<label>${esc(c.label)}</label><span></span><select ${c.inactive?'disabled':''}>${c.menu.map(m=>`<option value="${+m.value}" ${m.value===c.value?'selected':''}>${esc(m.label)}</option>`).join('')}</select>`;
      d.querySelector('select').onchange=e=>setCtl(c.name,+e.target.value);
    }else{
      d.innerHTML=`<label>${esc(c.label)}</label><span class="val">${+c.value}</span><input type="range" min="${+c.min}" max="${+c.max}" step="${+c.step}" value="${+c.value}" ${c.inactive?'disabled':''}>`;
      const r=d.querySelector('input'), v=d.querySelector('.val');
      r.oninput=e=>{v.textContent=e.target.value; setCtl(c.name,+e.target.value,true)};
      r.ondblclick=()=>{r.value=c.default; r.oninput({target:r})};
    }
    box.appendChild(d);
  }
}
let pending={},timer=null;
function setCtl(name,value,debounce){pending[name]=value; clearTimeout(timer); timer=setTimeout(flush,debounce?60:0)}
async function flush(){const b=pending; pending={}; const r=await post('/set',b); if(!r.ok) say(r.error||'Failed to set control'); state.controls=r.controls}
async function resetAll(){const r=await post('/reset'); state.controls=r.controls; renderControls(); say('Camera defaults restored')}

/* ---------------- layers ---------------- */
const BLENDS=['source-over','multiply','screen','overlay','darken','lighten','color-dodge','color-burn','hard-light','soft-light','difference','exclusion','hue','saturation','color','luminosity'];
const BLEND_LABEL={'source-over':'normal'};
let uid=1;
/*LAYER_DEF*/let layers=[defaultLayer('camera')];   // bottom → top
function addLayer(){layers.push(defaultLayer($('#addtype').value)); renderLayers()}
function moveLayer(i,d){const j=i+d; if(j<0||j>=layers.length)return; [layers[i],layers[j]]=[layers[j],layers[i]]; renderLayers()}
function removeLayer(i){layers.splice(i,1); renderLayers()}
const TYPE_NAME={camera:'Camera',edges:'Edges',color:'Colour',gradient:'Gradient',image:'Image',warp:'Warp'};
const EFFECTS={displace:'Displace',refract:'Refract (glass)',emboss:'Emboss (relief)',contour:'Contour lines',chroma:'Chroma split',flow:'Flow (smear along strokes)',kaleido:'Kaleidoscope',tilt:'3D tilt'};
const EFFECT_PARAMS={ // labels for strength,p1,p2,p3 per effect
  displace:['Strength','Direction bias','',''], refract:['Strength','Highlight','',''], emboss:['Height','Light angle','Light height','Mix'],
  contour:['Line weight','Line count','',''], chroma:['Strength','','',''], flow:['Length','Taps','',''], kaleido:['Rotation','Folds','Centre X','Centre Y'], tilt:['Tilt X','Tilt Y','Perspective','Spin']};
function range(label,key,min,max,step,obj,fmt){
  const v=obj[key]; const id='r'+Math.random().toString(36).slice(2);
  return `<label>${esc(label)}</label><div class="ctl"><span class="val" id="${id}v">${esc(fmt?fmt(v):v)}</span><input type="range" id="${id}" min="${+min}" max="${+max}" step="${+step}" value="${+v}" data-key="${esc(key)}"></div>`;
}
function renderLayers(){
  const box=$('#layers'); box.innerHTML='';
  const openIds=new Set([...box.querySelectorAll('details[open]')].map(d=>+d.dataset.id));
  // render top-most first
  for(let i=layers.length-1;i>=0;i--){
    const L=layers[i];
    const d=document.createElement('details'); d.dataset.id=L.id; if(L._open) d.open=true;
    let body=`<div class="grid">
      <label>Blend</label><select data-key="blend">${BLENDS.map(b=>`<option value="${b}" ${b===L.blend?'selected':''}>${BLEND_LABEL[b]||b}</option>`).join('')}</select>
      ${range('Opacity','opacity',0,1,0.01,L,v=>Math.round(v*100)+'%')}`;
    if(L.type==='edges') body+=`
      ${range('Threshold','threshold',0,1,0.01,L)}
      ${range('Thickness','thickness',0.5,4,0.1,L)}
      ${range('Smoothing','smooth',0,6,0.1,L)}
      <label>Edge colour</label><div class="row"><input type="color" data-key="color" value="${esc(L.color)}"></div>
      <label>Background</label><select data-key="bg"><option value="transparent" ${L.bg==='transparent'?'selected':''}>transparent</option><option value="black" ${L.bg==='black'?'selected':''}>black</option><option value="camera" ${L.bg==='camera'?'selected':''}>camera image</option></select>
      <label>Invert</label><input type="checkbox" data-key="invert" ${L.invert?'checked':''}>`;
    if(L.type==='color') body+=`<label>Colour</label><div class="row"><input type="color" data-key="color" value="${esc(L.color)}"></div>`;
    const assetRow=(label)=>`<label>${label}</label><div class="row"><input type="text" data-key="path" value="${esc(L.path)}" placeholder="path to .svg .png .jpg" style="flex:1;min-width:0"></div>
      <span></span><div class="row"><button class="icon act-upload">Upload…</button><button class="icon act-url">URL…</button><button class="icon act-prime">Prime…</button></div>`;
    if(L.type==='image') body+=`
      ${assetRow('File')}
      <label>Fit</label><select data-key="fit">${['contain','cover','stretch','tile'].map(f=>`<option value="${f}" ${L.fit===f?'selected':''}>${f}</option>`).join('')}</select>
      ${range('Scale','scale',0.05,4,0.01,L)}
      ${range('Position X','x',0,1,0.01,L)}
      ${range('Position Y','y',0,1,0.01,L)}
      ${range('Rotate','rotate',-180,180,1,L,v=>v+'°')}
      <label>SVG stroke</label><div class="row"><input type="color" data-key="stroke" value="${esc(L.stroke||'#ffffff')}"><button class="icon act-nostroke" title="Use the SVG's own colours">own colours</button></div>
      ${range('Stroke width','strokeScale',0.1,8,0.1,L,v=>v+'×')}`;
    if(L.type==='warp'){
      const lab=EFFECT_PARAMS[L.effect]||EFFECT_PARAMS.displace;
      body+=`
      <label>Source</label><select data-key="source"><option value="below" ${L.source==='below'?'selected':''}>everything below</option><option value="camera" ${L.source==='camera'?'selected':''}>camera</option></select>
      <label>Effect</label><select data-key="effect">${Object.entries(EFFECTS).map(([k,v])=>`<option value="${k}" ${L.effect===k?'selected':''}>${v}</option>`).join('')}</select>
      ${['kaleido','tilt'].includes(L.effect)?'':assetRow('Field')}
      ${['kaleido','tilt'].includes(L.effect)?'':`<label>Field fit</label><select data-key="fit">${['contain','cover','stretch','tile'].map(f=>`<option value="${f}" ${L.fit===f?'selected':''}>${f}</option>`).join('')}</select>`}
      ${['kaleido','tilt'].includes(L.effect)?'':range('Field blur','blur',0,40,0.5,L,v=>v+'px')}
      ${range(lab[0]||'Strength','strength',0,1,0.005,L)}
      ${lab[1]?range(lab[1],'p1',0,1,0.005,L):''}
      ${lab[2]?range(lab[2],'p2',0,1,0.005,L):''}
      ${lab[3]?range(lab[3],'p3',0,1,0.005,L):''}
      ${['contour','refract'].includes(L.effect)?`<label>Colour</label><div class="row"><input type="color" data-key="color" value="${esc(L.color)}"></div>`:''}`;
    }
    if(L.type==='gradient') body+=`
      <label>Shape</label><select data-key="shape"><option value="linear" ${L.shape==='linear'?'selected':''}>linear</option><option value="radial" ${L.shape==='radial'?'selected':''}>radial</option></select>
      <label>Colour A</label><div class="row"><input type="color" data-key="color" value="${esc(L.color)}"></div>
      ${range('Alpha A','alpha1',0,1,0.01,L,v=>Math.round(v*100)+'%')}
      <label>Colour B</label><div class="row"><input type="color" data-key="color2" value="${esc(L.color2)}"></div>
      ${range('Alpha B','alpha2',0,1,0.01,L,v=>Math.round(v*100)+'%')}
      ${range('Angle','angle',0,360,1,L,v=>v+'°')}`;
    body+=`</div><div class="sub"><h3>Alpha mask</h3><div class="grid">
      <label>Type</label><select data-key="mask.type"><option value="none" ${L.mask.type==='none'?'selected':''}>none</option><option value="linear" ${L.mask.type==='linear'?'selected':''}>linear gradient</option><option value="radial" ${L.mask.type==='radial'?'selected':''}>radial gradient</option></select>
      ${range('Angle','mask.angle',0,360,1,{['mask.angle']:L.mask.angle},v=>v+'°')}
      ${range('Centre X','mask.cx',0,1,0.01,{['mask.cx']:L.mask.cx})}
      ${range('Centre Y','mask.cy',0,1,0.01,{['mask.cy']:L.mask.cy})}
      ${range('Opaque until','mask.start',0,1,0.01,{['mask.start']:L.mask.start})}
      ${range('Clear after','mask.end',0,1,0.01,{['mask.end']:L.mask.end})}
      <label>Invert</label><input type="checkbox" data-key="mask.invert" ${L.mask.invert?'checked':''}>
    </div></div>`;
    d.innerHTML=`<summary><input type="checkbox" ${L.enabled?'checked':''} data-key="enabled" title="Enable" onclick="event.stopPropagation()">
      <span class="lname">${esc(TYPE_NAME[L.type]||L.type)}</span><span class="dim">${esc(BLEND_LABEL[L.blend]||L.blend)} · ${Math.round(L.opacity*100)}%</span>
      <button class="icon" title="Move up (toward front)">▲</button><button class="icon" title="Move down">▼</button><button class="icon danger" title="Delete">✕</button></summary>
      <div class="layer-body">${body}</div>`;
    const [up,down,del]=d.querySelectorAll('summary button');
    up.onclick=e=>{e.preventDefault();e.stopPropagation();moveLayer(i,+1)};
    down.onclick=e=>{e.preventDefault();e.stopPropagation();moveLayer(i,-1)};
    del.onclick=e=>{e.preventDefault();e.stopPropagation();removeLayer(i)};
    d.ontoggle=()=>{L._open=d.open};
    const bUp=d.querySelector('.act-upload'), bUrl=d.querySelector('.act-url'), bPrime=d.querySelector('.act-prime'), bOwn=d.querySelector('.act-nostroke');
    if(bUp) bUp.onclick=e=>{e.preventDefault(); pickFile(L)};
    if(bUrl) bUrl.onclick=e=>{e.preventDefault(); const u=prompt('Image or SVG URL'); if(u) fetchAsset(L,u)};
    if(bPrime) bPrime.onclick=e=>{e.preventDefault(); primeAsset(L)};
    if(bOwn) bOwn.onclick=e=>{e.preventDefault(); L.stroke=''; L._open=true; renderLayers()};
    const effSel=d.querySelector('select[data-key=effect]'); if(effSel) effSel.addEventListener('change',()=>{L._open=true; renderLayers()});
    d.querySelectorAll('[data-key]').forEach(el=>{
      const apply=()=>{
        let v = el.type==='checkbox'?el.checked : el.type==='range'?+el.value : el.value;
        const k=el.dataset.key;
        if(k.startsWith('mask.')) L.mask[k.slice(5)]=v; else L[k]=v;
        if(el.type==='range'){const s=document.getElementById(el.id+'v'); if(s){const key=k.split('.').pop(); s.textContent=(key==='opacity'||key.startsWith('alpha'))?Math.round(v*100)+'%':(key==='angle'?v+'°':v)}}
        if(k==='blend'||k==='opacity'){d.querySelector('.dim').textContent=`${BLEND_LABEL[L.blend]||L.blend} · ${Math.round(L.opacity*100)}%`}
      };
      el.oninput=apply; el.onchange=apply;
    });
    box.appendChild(d);
  }
}

/*RENDER_CORE*/
function frame(){
  requestAnimationFrame(frame);
  if(!cam.complete||!cam.naturalWidth) return;
  composite();
}
requestAnimationFrame(frame);

/* ---------------- presets ---------------- */
function cleanLayers(){return layers.map(({_open,...L})=>L)}
/*LOAD_LAYERS*/function renderPresets(){
  const box=$('#presets'); box.innerHTML='';
  const names=Object.keys(state.presets.presets).sort();
  if(!names.length){box.innerHTML='<div class="status">No presets yet. Adjust things, name it, Save.</div>';return}
  for(const n of names){
    const d=document.createElement('div'); d.className='preset';
    const on=state.presets.login===n;
    d.innerHTML=`<span class="name ${n===currentPreset?'current':''}">${esc(n)}</span><span class="login ${on?'on':''}" title="Apply this preset at login">${on?'★ login':'☆ login'}</span><span class="x" title="Delete">✕</span>`;
    d.querySelector('.name').onclick=()=>applyPreset(n);
    d.querySelector('.login').onclick=()=>setLogin(on?null:n);
    d.querySelector('.x').onclick=()=>deletePreset(n);
    box.appendChild(d);
  }
}
async function applyPreset(n){const r=await post('/preset/apply',{name:n}); state.controls=r.controls; renderControls(); loadLayers(r.layers); if(r.ok){currentPreset=n; $('#pname').value=n; updateSaveButton(); renderPresets(); previewName()} say(r.ok?`Applied "${n}"`:r.error)}
function updateSaveButton(){const n=$('#pname').value.trim(); const exists=n && state.presets.presets[n]!==undefined; $('#psave').textContent=exists?'Update':'Save'; $('#psave').title=exists?`Overwrite "${n}" with the current camera settings and layers`:'Save as a new preset'}
$('#pname').oninput=updateSaveButton;
$('#pname').onkeydown=e=>{if(e.key==='Enter')savePreset()};
async function savePreset(){const n=$('#pname').value.trim(); if(!n){say('Preset needs a name');return}
  const exists=state.presets.presets[n]!==undefined;
  if(exists && !confirm(`Overwrite preset "${n}" with the current camera settings and layers?`)) return;
  const r=await post('/preset/save',{name:n,layers:cleanLayers()}); if(r.ok){state.presets=r.presets; currentPreset=n; renderPresets(); previewName(); updateSaveButton(); say(exists?`Updated "${n}"`:`Saved "${n}"`)} else say(r.error)}
async function deletePreset(n){if(!confirm(`Delete preset "${n}"?`))return; const r=await post('/preset/delete',{name:n}); state.presets=r.presets; if(currentPreset===n){currentPreset=''; $('#pname').value=''} renderPresets(); updateSaveButton()}
async function setLogin(n){const r=await post('/preset/login',{name:n}); state.presets=r.presets; renderPresets(); say(n?`"${n}" will be applied at login`:'No preset at login')}
async function snap(){
  const blob=await new Promise(res=>out.toBlob(res,'image/png'));
  const r=await fetch('/snapshot',{method:'POST',headers:{'Content-Type':'image/png','X-Token':TOKEN,'X-Preset':encodeURIComponent(currentPreset)},body:blob}).then(r=>r.json());
  say(r.ok?'Saved '+r.path.split('/').pop():r.error);
}
/* ---------------- snapshot settings ---------------- */
function loadSettings(){const st=state.presets.settings||{}; $('#sfolder').value=st.folder||'~/Pictures'; $('#stemplate').value=st.template||'camera-[datetime]'; previewName()}
let ptimer=null;
function previewName(){clearTimeout(ptimer); ptimer=setTimeout(async()=>{
  // dry-run through the server so the example uses the exact same expansion; does not persist
  const t=$('#stemplate').value.trim()||'camera-[datetime]';
  const ex=t.replace('[preset]',currentPreset||'untitled').replace('[date]',new Date().toISOString().slice(0,10)).replace('[time]','HH-MM-SS').replace('[datetime]','YYYYMMDD-HHMMSS').replace('[n]','001');
  $('#sexample').textContent='e.g. '+ex+'.png';
},150)}
$('#stemplate').oninput=previewName;
async function saveSettings(){const r=await post('/settings',{folder:$('#sfolder').value,template:$('#stemplate').value,preset:currentPreset}); if(r.ok){state.presets.settings=r.settings; $('#sfolder').value=r.settings.folder; $('#stemplate').value=r.settings.template; $('#sexample').textContent='e.g. '+r.example; say('Snapshot settings saved')} else say(r.error)}
async function openFolder(){await saveSettings(); post('/open-folder')}
async function quit(){await post('/quit'); window.close(); document.body.innerHTML='<p style="padding:2em">Camera panel closed.</p>'}
fetch('/state',{headers:{'X-Token':TOKEN}}).then(r=>r.json()).then(s=>{state=s; renderControls(); renderPresets(); renderLayers(); loadSettings();
  if(s.presets.login) applyPreset(s.presets.login); // open with the login look, layers included
});
</script></body></html>""")

RENDER_PAGE = r"""<!doctype html><html><head><meta charset="utf-8"><title>render</title></head>
<body style="margin:0;background:#000"><canvas id="out"></canvas><img id="cam" alt="" hidden>
<script>
