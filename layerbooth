# ---------------------------------------------------------------- headless render (CLI)
class RenderHandler(Guarded):
    input_bytes = b""
    input_type = "image/jpeg"
    layers = []
    fmt = "image/png"
    quality = 0.92
    result = None
    done = threading.Event()

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/render":
            body = (assemble(RENDER_PAGE).replace("/*LAYERS_JSON*/", json.dumps(self.layers).replace("</", "<\\/"))
                    .replace("/*FORMAT*/", self.fmt).replace("/*QUALITY*/", str(float(self.quality)))
                    .replace("/*TOKEN*/", self.token)).encode()
            ctype = "text/html; charset=utf-8"
        elif path == "/input":
            body, ctype = self.input_bytes, self.input_type
        else:
            return self.send_error(404)
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        data = self.read_body(MAX_IMAGE_BODY)
        if data is None:
            return
        if self.headers.get("Content-Type", "").startswith("text/plain"):
            RenderHandler.result = ("error", data.decode(errors="replace"))
        else:
            RenderHandler.result = ("ok", data)
        self.send_response(204); self.end_headers()
        RenderHandler.done.set()

def find_browser():
    import shutil
    for b in ("chromium", "chromium-browser", "google-chrome-stable", "google-chrome", "brave", "helium"):
        path = shutil.which(b)
        if path:
            return path
    return None

def sniff_type(data):
    if data[:8] == b"\x89PNG\r\n\x1a\n": return "image/png"
    if data[:3] == b"\xff\xd8\xff": return "image/jpeg"
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP": return "image/webp"
    if data[:6] in (b"GIF87a", b"GIF89a"): return "image/gif"
    return "image/jpeg"

def render_cli(args):
    """render [--preset NAME | --layers FILE] [--format png|jpg] [--quality Q] [--out FILE] [INPUT|-]"""
    import tempfile
    preset = layers_file = out = None
    fmt, quality, inputs = "png", 0.92, []
    it = iter(args)
    for a in it:
        if a == "--preset": preset = next(it)
        elif a == "--layers": layers_file = next(it)
        elif a == "--out": out = next(it)
        elif a == "--format": fmt = next(it).lower().lstrip(".")
        elif a == "--quality": quality = float(next(it))
        elif a in ("-h", "--help"):
            print(render_cli.__doc__); return 0
        else: inputs.append(a)
    if len(inputs) > 1:
        print("render: one input at a time", file=sys.stderr); return 2
    src = inputs[0] if inputs else "-"
    data = sys.stdin.buffer.read() if src == "-" else open(src, "rb").read()
    if not data:
        print("render: no input image", file=sys.stderr); return 2
    if preset:
        p = load_presets()
        if preset not in p["presets"]:
            print(f"render: no preset named {preset!r}", file=sys.stderr); return 1
        layers = p["presets"][preset]["layers"]
    elif layers_file:
        with open(layers_file) as f:
            layers = json.load(f)
        if isinstance(layers, dict): layers = layers.get("layers", [])
    else:
        layers = [DEFAULT_LAYER]
    browser = find_browser()
    if not browser:
        print("render: needs a Chromium-based browser for headless rendering", file=sys.stderr); return 1

    RenderHandler.input_bytes = data
    RenderHandler.input_type = sniff_type(data)
    RenderHandler.layers = layers
    RenderHandler.fmt = {"jpg": "image/jpeg", "jpeg": "image/jpeg", "webp": "image/webp"}.get(fmt, "image/png")
    RenderHandler.quality = max(0.0, min(1.0, quality))
    RenderHandler.result = None
    RenderHandler.done.clear()
    port = free_port()
    RenderHandler.token = secrets.token_urlsafe(32)
    RenderHandler.port = port
    httpd = ThreadingHTTPServer(("127.0.0.1", port), RenderHandler)
    httpd.daemon_threads = True
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    with tempfile.TemporaryDirectory(prefix="layerbooth-render-", dir=os.environ.get("XDG_RUNTIME_DIR")) as profile:
        proc = subprocess.Popen([browser, "--headless=new", "--disable-gpu", "--no-first-run", "--no-default-browser-check",
                                 "--disable-extensions", f"--user-data-dir={profile}", "--window-size=1280,720",
                                 f"http://127.0.0.1:{port}/render?t={RenderHandler.token}"],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        ok = RenderHandler.done.wait(60)
        proc.terminate()
        try: proc.wait(5)
        except subprocess.TimeoutExpired: proc.kill()
    httpd.shutdown()
    if not ok or RenderHandler.result is None:
        print("render: browser produced no output within 60s", file=sys.stderr); return 1
    status, payload = RenderHandler.result
    if status != "ok":
        print(f"render: {payload}", file=sys.stderr); return 1
    if out and out != "-":
        with open(out, "wb") as f: f.write(payload)
    else:
        sys.stdout.buffer.write(payload); sys.stdout.buffer.flush()
    return 0

# ---------------------------------------------------------------- main
def free_port():
    s = socket.socket(); s.bind(("127.0.0.1", 0)); p = s.getsockname()[1]; s.close(); return p

def cli_apply(name):
    p = load_presets()
    name = name or p.get("login")
    if not name:
        print("No preset marked for login; nothing applied.", file=sys.stderr); return 0
    vals = p["presets"].get(name)
    if vals is None:
        print(f"No preset named {name!r}", file=sys.stderr); return 1
    vals = preset_controls(vals)
    # camera module may still be probing right after boot
    for _ in range(20):
        if os.path.exists(DEVICE): break
        time.sleep(0.5)
    ok, err = set_controls(vals)
    print(f"Applied preset {name!r}" if ok else f"Failed: {err}", file=sys.stderr)
    return 0 if ok else 1

def serve():
    port = free_port()
    Handler.token = secrets.token_urlsafe(32)
    Handler.port = port
    Handler.streamer = Streamer(DEVICE)
    Handler.colors = theme_colors()
    httpd = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    httpd.daemon_threads = True
    Handler.server_ref = httpd
    url = f"http://127.0.0.1:{port}/layerbooth?t={Handler.token}"  # path becomes part of Chromium's app id
    if "--no-browser" not in sys.argv:
        which = __import__("shutil").which
        if which("omarchy-launch-webapp"):
            cmd = ["omarchy-launch-webapp", url, "--window-size=1280,780"]
        else:
            browser = find_browser()
            if not browser:
                print("layerbooth: no Chromium-based browser found; open this URL yourself:", url, file=sys.stderr)
                cmd = None
            else:
                cmd = [browser, f"--app={url}", "--window-size=1280,780"]
        if cmd:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    else:
        print(url, flush=True)

    def idle_watch():
        st = Handler.streamer
        while True:
            time.sleep(5)
            if st.clients == 0 and time.time() - st.last_client > IDLE_EXIT_SECONDS:
                httpd.shutdown(); return
    threading.Thread(target=idle_watch, daemon=True).start()
    signal.signal(signal.SIGTERM, lambda *a: threading.Thread(target=httpd.shutdown).start())
    try:
        httpd.serve_forever()
    finally:
        Handler.streamer.stop()

if __name__ == "__main__":
    args = sys.argv[1:]
    if "--device" in args:
        DEVICE = args[args.index("--device") + 1]
    else:
        DEVICE = detect_device()
    if "--devices" in args:
        for dev, name in list_devices():
            print(f"{dev}  {name}")
        sys.exit(0)
    if args and args[0] == "render":
        sys.exit(render_cli(args[1:]))
    if "--list" in args:
        p = load_presets()
        for n, v in sorted(p["presets"].items()):
            c = preset_controls(v); nl = len(v["layers"]) if isinstance(v, dict) and "layers" in v else 0
            print(("* " if p["login"] == n else "  ") + n + "  " + ", ".join(f"{k}={x}" for k, x in c.items()) + f"  [{nl} layers]")
        sys.exit(0)
    if "--apply" in args:
        i = args.index("--apply")
        name = args[i + 1] if i + 1 < len(args) and not args[i + 1].startswith("--") else None
        sys.exit(cli_apply(name))
    if "-h" in args or "--help" in args:
        print(__doc__); sys.exit(0)
    serve()
