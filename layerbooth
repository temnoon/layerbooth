#!/usr/bin/env python3
"""Layerbooth — camera control panel with a layered effects stack.

Live preview of a V4L2 camera with sliders for every control the driver
exposes, snapshots, and named presets that can be re-applied at login.

Works with any V4L2 camera. Runs on Omarchy out of the box and on any other
Wayland/X11 desktop that has Python 3, ffmpeg, v4l-utils and a Chromium-based
browser.

Environment:
  LAYERBOOTH_CONFIG_DIR      where presets.json lives (default ~/.config/layerbooth)

Usage:
  layerbooth                 open the panel (server + browser app window)
  layerbooth --apply         apply the preset marked "apply at login"
  layerbooth --apply NAME    apply a named preset
  layerbooth --list          list presets
  layerbooth --devices              list capture devices
  layerbooth --device /dev/videoN ...
  layerbooth render [--preset NAME | --layers FILE] [--format png|jpg|webp]
                              [--quality 0-1] [--out FILE] [INPUT|-]
                                       apply a layer stack to an image: reads INPUT (or stdin),
                                       writes the composited image to --out (or stdout)
   layerbooth page [--preset NAME | --layers FILE] [--paper A5] [--structure dots] [--out page.json]
                                        render a look at paper size and write a gravity-press
                                        PageSpec v1 (or a DocumentSpec with --document COUNT)
   layerbooth live [--preset NAME | --layers FILE] [--source camera|test|DEVICE]
                   [--input IMAGE] [--out DEVICE] [--fps N] [--quality 0-1]
                                        composite a layer stack over a live foreground (camera, test
                                        pattern, another device, or a still image) and write it to a
                                        v4l2loopback camera that OBS and other video apps can use
"""
import glob, json, os, re, secrets, signal, socket, subprocess, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse, unquote

DEVICE = None  # resolved by detect_device() unless --device is given
CONFIG_DIR = os.environ.get("LAYERBOOTH_CONFIG_DIR") or os.path.expanduser("~/.config/layerbooth")
PRESETS_FILE = os.path.join(CONFIG_DIR, "presets.json")
PICTURES = os.path.expanduser("~/Pictures")
IDLE_EXIT_SECONDS = 20
BOUNDARY = "omarchyframe"

# ---------------------------------------------------------------- device discovery
def capture_capable(device):
    out = subprocess.run(["v4l2-ctl", "-d", device, "--info"], capture_output=True, text=True).stdout
    caps = out.split("Device Caps", 1)[-1] if "Device Caps" in out else ""
    return "Video Capture" in caps

def list_devices():
    """[(path, name)] for every V4L2 node that can capture video, first is the default."""
    devices = []
    which = __import__("shutil").which
    if which("omarchy-capture-webcam-list"):
        out = subprocess.run(["omarchy-capture-webcam-list"], capture_output=True, text=True).stdout
        for line in out.splitlines():
            parts = line.split(None, 1)
            if parts and parts[0].startswith("/dev/video"):
                devices.append((parts[0], parts[1].rstrip(":") if len(parts) > 1 else parts[0]))
        if devices:
            return devices
    out = subprocess.run(["v4l2-ctl", "--list-devices"], capture_output=True, text=True).stdout
    name, seen = "", set()
    for line in out.splitlines():
        if line and not line[0].isspace():
            name = line.rstrip(":")
        elif line.strip().startswith("/dev/video"):
            dev = line.strip()
            if name not in seen and capture_capable(dev):
                seen.add(name)
                devices.append((dev, name))
    if not devices:
        for i in range(10):
            dev = f"/dev/video{i}"
            if os.path.exists(dev) and capture_capable(dev):
                devices.append((dev, dev))
    return devices

def detect_device():
    devices = list_devices()
    return devices[0][0] if devices else "/dev/video0"

def native_mjpeg(device):
    out = subprocess.run(["v4l2-ctl", "-d", device, "--list-formats"], capture_output=True, text=True).stdout
    return "'MJPG'" in out

# ---------------------------------------------------------------- assets (images and SVGs for layers)
ASSET_EXTS = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".webp": "image/webp",
              ".gif": "image/gif", ".svg": "image/svg+xml"}
ASSET_ROOTS = [os.path.expanduser("~"), "/usr/share", "/tmp", os.environ.get("XDG_RUNTIME_DIR") or "/nonexistent"]

def assets_dir():
    d = os.path.join(CONFIG_DIR, "assets")
    os.makedirs(d, exist_ok=True)
    return d

def asset_ok(path):
    """Only image files, only under the user's home or shared data dirs."""
    real = os.path.realpath(os.path.expanduser(path or ""))
    ext = os.path.splitext(real)[1].lower()
    if ext not in ASSET_EXTS or not os.path.isfile(real):
        return None
    if not any(real == r or real.startswith(r.rstrip("/") + "/") for r in ASSET_ROOTS):
        return None
    return real

def serve_asset(handler, path):
    real = asset_ok(path)
    if not real:
        return handler.send_error(404, "No such asset")
    with open(real, "rb") as f:
        body = f.read()
    handler.send_response(200)
    handler.send_header("Content-Type", ASSET_EXTS[os.path.splitext(real)[1].lower()])
    handler.send_header("Content-Length", str(len(body)))
    handler.send_header("Cache-Control", "no-store")
    handler.end_headers()
    handler.wfile.write(body)

def serve_asset_text(handler):
    """POST /asset/text: the SVG source of an asset, for stroke recolouring."""
    raw = handler.read_body(MAX_JSON_BODY) or b"{}"
    try:
        real = asset_ok(json.loads(raw).get("path"))
    except (ValueError, AttributeError):
        real = None
    svg = open(real, encoding="utf-8", errors="replace").read() if real else ""
    body = json.dumps({"ok": bool(real), "svg": svg}).encode()
    handler.send_response(200)
    handler.send_header("Content-Type", "application/json")
    handler.send_header("Content-Length", str(len(body)))
    handler.end_headers()
    handler.wfile.write(body)

def store_asset(data, name, ext):
    import hashlib
    ext = ext.lower()
    if ext not in ASSET_EXTS:
        raise ValueError("unsupported file type")
    stem = safe_name(os.path.splitext(name or "asset")[0])[:60]
    digest = hashlib.sha256(data).hexdigest()[:10]
    path = os.path.join(assets_dir(), f"{stem}-{digest}{ext}")
    if not os.path.exists(path):
        with open(path, "wb") as f:
            f.write(data)
    return path

def fetch_asset(url):
    """Download an image or SVG over http(s) into the assets folder."""
    import urllib.request, urllib.parse
    u = urllib.parse.urlparse(url)
    if u.scheme not in ("http", "https"):
        raise ValueError("only http(s) URLs")
    req = urllib.request.Request(url, headers={"User-Agent": "layerbooth/0.2", "Accept": "image/svg+xml,image/*"})
    with urllib.request.urlopen(req, timeout=30) as r:
        ctype = (r.headers.get("Content-Type") or "").split(";")[0].strip().lower()
        data = r.read(MAX_ASSET_BODY + 1)
    if len(data) > MAX_ASSET_BODY:
        raise ValueError("file too large")
    by_type = {v: k for k, v in ASSET_EXTS.items()}
    ext = by_type.get(ctype) or os.path.splitext(u.path)[1].lower()
    if ext not in ASSET_EXTS:
        if data.lstrip()[:5] in (b"<?xml", b"<svg ") or b"<svg" in data[:2000]:
            ext = ".svg"
        else:
            raise ValueError(f"not an image ({ctype or 'unknown type'})")
    name = os.path.basename(u.path) or "download"
    if u.query:
        name += "-" + safe_name(u.query)[:40]
    return store_asset(data, name, ext)

# ---------------------------------------------------------------- v4l2 helpers
CTRL_RE = re.compile(r"^\s*(\w+)\s+0x[0-9a-f]+\s+\((\w+)\)\s*:\s*(.*)$")
MENU_RE = re.compile(r"^\s+(\d+):\s*(.*)$")

def list_controls(device=None):
    device = device or DEVICE
    out = subprocess.run(["v4l2-ctl", "-d", device, "--list-ctrls-menus"],
                         capture_output=True, text=True).stdout
    controls, current = [], None
    for line in out.splitlines():
        m = CTRL_RE.match(line)
        if m:
            name, typ, rest = m.groups()
            attrs = dict(re.findall(r"(\w+)=(-?\w+)", rest))
            current = {"name": name, "type": typ,
                       "label": name.replace("_", " "),
                       "min": int(attrs.get("min", 0)), "max": int(attrs.get("max", 1)),
                       "step": int(attrs.get("step", 1)),
                       "default": int(attrs.get("default", 0)),
                       "value": int(attrs.get("value", 0)),
                       "inactive": "inactive" in attrs.get("flags", ""),
                       "menu": []}
            controls.append(current)
            continue
        mm = MENU_RE.match(line)
        if mm and current is not None and current["type"] in ("menu", "intmenu"):
            current["menu"].append({"value": int(mm.group(1)), "label": mm.group(2)})
    return controls

def preset_controls(preset):
    """Presets are {controls:{}, layers:[]}; older ones were a flat controls dict."""
    if isinstance(preset, dict) and "controls" in preset:
        return preset["controls"]
    return preset

def set_controls(values, device=None):
    device = device or DEVICE
    if not values:
        return True, ""
    arg = ",".join(f"{k}={int(v)}" for k, v in values.items())
    r = subprocess.run(["v4l2-ctl", "-d", device, "--set-ctrl", arg],
                       capture_output=True, text=True)
    return r.returncode == 0, r.stderr.strip()

# ---------------------------------------------------------------- presets
DEFAULT_SETTINGS = {"folder": "~/Pictures", "template": "camera-[datetime]"}
DEFAULT_LAYER = {"type": "camera", "enabled": True, "opacity": 1, "blend": "source-over"}
TOKENS = ["[preset]", "[date]", "[time]", "[datetime]", "[n]"]

def load_presets():
    try:
        with open(PRESETS_FILE) as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    data.setdefault("presets", {})
    data.setdefault("login", None)
    data["settings"] = {**DEFAULT_SETTINGS, **(data.get("settings") or {})}
    for name, preset in list(data["presets"].items()):
        if not isinstance(preset, dict) or "controls" not in preset:
            preset = {"controls": preset, "layers": []}
        if not preset.get("layers"):
            preset["layers"] = [DEFAULT_LAYER]
        data["presets"][name] = preset
    return data

def safe_name(text):
    text = re.sub(r"[/\\:*?\"<>|\x00-\x1f]+", "-", str(text)).strip(" .")
    return text[:200] or "untitled"

def snapshot_path(settings, preset, ext, create=True):
    """Expand the filename template. [n] is the lowest counter that doesn't collide."""
    folder = os.path.expanduser(settings.get("folder") or DEFAULT_SETTINGS["folder"])
    template = settings.get("template") or DEFAULT_SETTINGS["template"]
    now = time.localtime()
    name = template
    name = name.replace("[preset]", safe_name(preset) if preset else "untitled")
    name = name.replace("[date]", time.strftime("%Y-%m-%d", now))
    name = name.replace("[time]", time.strftime("%H-%M-%S", now))
    name = name.replace("[datetime]", time.strftime("%Y%m%d-%H%M%S", now))
    # "/" makes sub-folders, but every segment is sanitised and ".." / absolute paths are refused
    parts = [safe_name(seg) for seg in name.split("/") if seg.strip(" .")]
    name = "/".join(parts) or "untitled"
    if not name.lower().endswith(ext):
        name += ext
    if create:
        os.makedirs(os.path.dirname(os.path.join(folder, name)), exist_ok=True)
    if "[n]" in name:
        for i in range(1, 100000):
            candidate = os.path.join(folder, name.replace("[n]", f"{i:03d}"))
            if not os.path.exists(candidate):
                return candidate
    path = os.path.join(folder, name)
    if os.path.exists(path):  # never overwrite: append a counter
        stem, e = os.path.splitext(path)
        i = 2
        while os.path.exists(f"{stem}-{i}{e}"):
            i += 1
        path = f"{stem}-{i}{e}"
    return path

def save_presets(data):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = PRESETS_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2, sort_keys=True)
    os.replace(tmp, PRESETS_FILE)

# ---------------------------------------------------------------- theme
def theme_colors():
    """Read the active Omarchy theme's colors.toml (flat key = "#hex" file)."""
    colors = {}
    try:
        name = subprocess.run(["omarchy-theme-current"], capture_output=True, text=True).stdout.strip()
        d = subprocess.run(["omarchy-theme-dir", name], capture_output=True, text=True).stdout.strip()
        with open(os.path.join(d, "colors.toml")) as f:
            for line in f:
                m = re.match(r'^\s*(\w+)\s*=\s*"(#[0-9a-fA-F]{6})"', line)
                if m:
                    colors[m.group(1)] = m.group(2)
    except Exception:
        pass
    return colors

# ---------------------------------------------------------------- streamer
class Streamer:
    """One ffmpeg process reading a camera (or the test pattern); frames fanned out to clients."""
    def __init__(self, device=None, cmd=None):
        self.device = device
        self.cmd = cmd  # explicit ffmpeg command; None = read self.device
        self.proc = None
        self.lock = threading.Condition()
        self.frame = None
        self.seq = 0
        self.clients = 0
        self.last_client = time.time()

    def start(self):
        if self.proc and self.proc.poll() is None:
            return
        if self.cmd:
            cmd = self.cmd
        elif native_mjpeg(self.device):
            cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-f", "v4l2", "-input_format", "mjpeg",
                   "-i", self.device, "-c:v", "copy", "-f", "mpjpeg", "-"]
        else:
            cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-f", "v4l2",
                   "-i", self.device, "-f", "mpjpeg", "-q:v", "4", "-"]
        self.proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        threading.Thread(target=self._reader, daemon=True).start()

    def _reader(self):
        out = self.proc.stdout
        while True:
            # ffmpeg mpjpeg: boundary, headers, blank line, body
            length = None
            while True:
                line = out.readline()
                if not line:
                    return
                if line.lower().startswith(b"content-length:"):
                    length = int(line.split(b":")[1])
                if line in (b"\r\n", b"\n") and length is not None:
                    break
            body = out.read(length)
            if len(body) < length:
                return
            with self.lock:
                self.frame = body
                self.seq += 1
                self.lock.notify_all()

    def stop(self):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(3)
            except subprocess.TimeoutExpired:
                self.proc.kill()

    def next_frame(self, seen):
        with self.lock:
            self.lock.wait_for(lambda: self.seq != seen, timeout=2)
            return self.frame, self.seq

def foreground_streamer(source):
    """A Streamer for the live foreground: a camera device or the built-in test pattern."""
    if source == "test":
        cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-re", "-f", "lavfi",
               "-i", "testsrc2=size=1280x720:rate=30", "-f", "mpjpeg", "-q:v", "4", "-"]
        return Streamer(cmd=cmd)
    return Streamer(source)

def serve_stream(handler, s):
    """GET /stream: the MJPEG fan-out, shared by the panel and the live compositor."""
    s.start()
    s.clients += 1
    handler.send_response(200)
    handler.send_header("Content-Type", f"multipart/x-mixed-replace; boundary={BOUNDARY}")
    handler.send_header("Cache-Control", "no-cache")
    handler.end_headers()
    seen = -1
    try:
        while True:
            frame, seen = s.next_frame(seen)
            if frame is None:
                continue
            handler.wfile.write(f"--{BOUNDARY}\r\nContent-Type: image/jpeg\r\n"
                                f"Content-Length: {len(frame)}\r\n\r\n".encode())
            handler.wfile.write(frame)
            handler.wfile.write(b"\r\n")
            handler.wfile.flush()
    except (BrokenPipeError, ConnectionResetError, OSError):
        pass
    finally:
        s.clients -= 1
        s.last_client = time.time()

# ---------------------------------------------------------------- live out (v4l2loopback)
def list_loopbacks():
    """[(path, card)] for every v4l2loopback device, Layerbooth-labelled ones first."""
    found = []
    for dev in sorted(glob.glob("/dev/video*")):
        info = subprocess.run(["v4l2-ctl", "-d", dev, "--info"], capture_output=True, text=True).stdout
        def field(name, info=info):
            return next((l.split(":", 1)[1].strip() for l in info.splitlines()
                         if l.split(":", 1)[0].strip() == name), "")
        if field("Driver name") == "v4l2loopback":
            found.append((dev, field("Card type") or dev))
    found.sort(key=lambda d: d[1] != "Layerbooth")
    return found

class LivePipe:
    """JPEG frames in, one ffmpeg process out to a v4l2loopback device (or to /dev/null)."""
    def __init__(self, device, fps):
        self.device, self.fps = device, fps
        self.proc = None
        self.lock = threading.Lock()
        self.sent = 0
        self.errs = []

    def start(self, discard=False):
        cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-f", "image2pipe",
               "-framerate", str(self.fps), "-i", "-", "-an",
               "-c:v", "rawvideo", "-pix_fmt", "yuv420p"]
        cmd += ["-f", "null", "-"] if discard else ["-f", "v4l2", self.device]
        self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stderr=subprocess.PIPE)
        self.errs = []
        threading.Thread(target=self._watch, daemon=True).start()

    def _watch(self):
        for line in self.proc.stderr:
            if len(self.errs) < 15:
                self.errs.append(line.decode(errors="replace").rstrip())
        self.proc.wait()

    def write(self, jpeg):
        if not self.proc or self.proc.poll() is not None:
            return False
        try:
            with self.lock:
                self.proc.stdin.write(jpeg)
                self.proc.stdin.flush()
        except (BrokenPipeError, OSError):
            return False
        self.sent += 1
        return True

    def stop(self):
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.stdin.close()
            except OSError:
                pass
            self.proc.terminate()
            try:
                self.proc.wait(3)
            except subprocess.TimeoutExpired:
                self.proc.kill()

# ---------------------------------------------------------------- request guard
MAX_JSON_BODY = 1 << 20        # 1 MiB of JSON is plenty for a layer stack
MAX_IMAGE_BODY = 64 << 20      # composited snapshot / render result
MAX_ASSET_BODY = 32 << 20      # uploaded or fetched layer asset

class Guarded(BaseHTTPRequestHandler):
    """Every request must carry the per-run token, come from our own origin, and
    address our own host. That keeps other local users, DNS-rebinding pages and
    cross-site requests from any web page out of the camera and the filesystem."""
    token = ""
    port = 0
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def authorized(self):
        host = self.headers.get("Host", "")
        if host != f"127.0.0.1:{self.port}":
            return False
        origin = self.headers.get("Origin")
        if origin and origin != f"http://127.0.0.1:{self.port}":
            return False
        q = parse_qs(urlparse(self.path).query)
        supplied = self.headers.get("X-Token") or (q.get("t") or [""])[0]
        return bool(self.token) and secrets.compare_digest(supplied, self.token)

    def parse_request(self):
        if not super().parse_request():
            return False
        if self.authorized():
            return True
        self.send_error(403, "Forbidden")
        self.close_connection = True
        return False

    def read_body(self, limit):
        try:
            n = int(self.headers.get("Content-Length", 0))
        except ValueError:
            n = -1
        if n < 0 or n > limit:
            self.send_error(413, "Body too large")
            self.close_connection = True
            return None
        return self.rfile.read(n)

# ---------------------------------------------------------------- web
class Handler(Guarded):
    streamer: Streamer = None
    colors: dict = {}
    server_ref = None

    def _json(self, obj, code=200):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _body(self):
        raw = self.read_body(MAX_JSON_BODY)
        if raw is None:
            raise ValueError("body too large")
        try:
            body = json.loads(raw or b"{}")
        except ValueError:
            body = {}
        return body if isinstance(body, dict) else {}

    def do_GET(self):
        u = urlparse(self.path)
        if u.path in ("/", "/layerbooth"):
            body = (PAGE.replace("/*THEME*/", theme_css(self.colors))
                        .replace("/*TOKEN*/", self.token)).encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif u.path == "/stream":
            self._stream()
        elif u.path == "/state":
            self._json({"device": DEVICE, "controls": list_controls(), "presets": load_presets(),
                        "assets_dir": assets_dir()})
        elif u.path == "/asset":
            serve_asset(self, (parse_qs(u.query).get("path") or [""])[0])
        else:
            self.send_error(404)

    def do_POST(self):
        try:
            self._post()
        except ValueError:
            pass  # read_body already answered 413

    def _post(self):
        u = urlparse(self.path)
        p = load_presets()
        if u.path == "/set":
            known = {c["name"] for c in list_controls()}
            wanted = {}
            for k, v in self._body().items():
                if k in known and isinstance(v, (int, float, bool)):
                    wanted[k] = int(v)
            ok, err = set_controls(wanted)
            self._json({"ok": ok, "error": err, "controls": list_controls()})
        elif u.path == "/reset":
            defaults = {c["name"]: c["default"] for c in list_controls()}
            set_controls(defaults)
            self._json({"ok": True, "controls": list_controls()})
        elif u.path == "/preset/save":
            b = self._body()
            name = (b.get("name") or "").strip()
            if not name:
                return self._json({"ok": False, "error": "Preset needs a name"}, 400)
            p["presets"][name] = {"controls": {c["name"]: c["value"] for c in list_controls()},
                                  "layers": b.get("layers") or []}
            save_presets(p)
            self._json({"ok": True, "presets": p})
        elif u.path == "/preset/apply":
            name = self._body().get("name")
            preset = p["presets"].get(name)
            if preset is None:
                return self._json({"ok": False, "error": "No such preset"}, 404)
            ok, err = set_controls(preset_controls(preset))
            layers = preset.get("layers") if isinstance(preset, dict) else None
            self._json({"ok": ok, "error": err, "controls": list_controls(), "layers": layers or [DEFAULT_LAYER]})
        elif u.path == "/preset/delete":
            name = self._body().get("name")
            p["presets"].pop(name, None)
            if p["login"] == name:
                p["login"] = None
            save_presets(p)
            self._json({"ok": True, "presets": p})
        elif u.path == "/preset/login":
            name = self._body().get("name")
            p["login"] = name if name in p["presets"] else None
            save_presets(p)
            self._json({"ok": True, "presets": p})
        elif u.path == "/snapshot":
            preset = unquote(self.headers.get("X-Preset", ""))
            if self.headers.get("Content-Type", "").startswith("image/png"):
                # composited frame rendered by the page
                frame = self.read_body(MAX_IMAGE_BODY)
                if frame is None:
                    return
                ext = ".png"
            else:
                frame, _ = self.streamer.next_frame(-1)
                if not frame:
                    return self._json({"ok": False, "error": "No frame yet"}, 503)
                ext = ".jpg"
            try:
                path = snapshot_path(p["settings"], preset, ext)
                with open(path, "wb") as f:
                    f.write(frame)
            except OSError as e:
                return self._json({"ok": False, "error": f"Cannot write snapshot: {e}"}, 500)
            notifier = "omarchy-notification-send" if __import__("shutil").which("omarchy-notification-send") else "notify-send"
            subprocess.Popen([notifier, "-i", "camera-photo", "Snapshot saved", path],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self._json({"ok": True, "path": path})
        elif u.path == "/settings":
            b = self._body()
            folder = (b.get("folder") or "").strip() or DEFAULT_SETTINGS["folder"]
            template = (b.get("template") or "").strip() or DEFAULT_SETTINGS["template"]
            settings = {"folder": folder, "template": template}
            try:
                example = os.path.relpath(snapshot_path(settings, b.get("preset") or "", ".png", create=False),
                                          os.path.expanduser(folder))
                os.makedirs(os.path.expanduser(folder), exist_ok=True)
                if not os.access(os.path.expanduser(folder), os.W_OK):
                    raise OSError("folder is not writable")
            except OSError as e:
                return self._json({"ok": False, "error": f"Snapshot folder problem: {e}"}, 400)
            p["settings"] = settings
            save_presets(p)
            self._json({"ok": True, "settings": p["settings"], "example": example})
        elif u.path == "/open-folder":
            folder = os.path.expanduser(p["settings"]["folder"])
            os.makedirs(folder, exist_ok=True)
            subprocess.Popen(["xdg-open", folder], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self._json({"ok": True})
        elif u.path == "/asset/upload":
            data = self.read_body(MAX_ASSET_BODY)
            if data is None:
                return
            name = unquote(self.headers.get("X-Filename", "upload"))
            try:
                path = store_asset(data, name, os.path.splitext(name)[1])
            except ValueError as e:
                return self._json({"ok": False, "error": str(e)}, 400)
            self._json({"ok": True, "path": path})
        elif u.path == "/asset/fetch":
            url = (self._body().get("url") or "").strip()
            try:
                path = fetch_asset(url)
            except Exception as e:
                return self._json({"ok": False, "error": f"Fetch failed: {e}"}, 400)
            self._json({"ok": True, "path": path})
        elif u.path == "/asset/text":
            real = asset_ok(self._body().get("path"))
            if not real or not real.lower().endswith(".svg"):
                return self._json({"ok": False, "error": "Not an SVG asset"}, 404)
            with open(real, "r", encoding="utf-8", errors="replace") as f:
                self._json({"ok": True, "svg": f.read(MAX_ASSET_BODY)})
        elif u.path == "/quit":
            self._json({"ok": True})
            threading.Thread(target=self.server_ref.shutdown, daemon=True).start()
        else:
            self.send_error(404)

